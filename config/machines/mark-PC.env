# mark-PC: Ubuntu nativo, máquina personal de escritorio.
#
# OJO: la ruta del vault contiene un espacio ("Obsidian Vault"), por eso los
# valores van entrecomillados — este archivo se carga con `source` y sin
# comillas bash parte la ruta en dos.
MEMORIA_VAULT_ROOT="/home/mark/Documentos/Obsidian Vault/Claude"
MEMORIA_MACHINE="mark-PC"
MEMORIA_PROFILE="personal"
MEMORIA_REPO_DIR="$HOME/Code/wilson-romero/claude-memory-system"

# gdrive:Obsidian es la carpeta de ESTA máquina, no un remoto genérico.
# No apuntar otra máquina aquí: sus vaults no son intercambiables y bisync
# resolvería el choque con "gana el más nuevo", perdiendo un lado en silencio.
# Cada máquina lleva su propia carpeta (PC-WILSON → gdrive:Obsidian-PC-WILSON).
MEMORIA_SYNC="rclone"
MEMORIA_SYNC_REMOTE="gdrive:Obsidian"
MEMORIA_LOG="$HOME/.local/log/memoria-cc.log"

# La unión de conocimiento con la otra máquina personal se configura FUERA del
# repo, en ~/.claude/memoria.local.env — lleva IP, usuario y puerto SSH, que no
# deben versionarse. Ver docs/arquitectura.md § Sincronización.
