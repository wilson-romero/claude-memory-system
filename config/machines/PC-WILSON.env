MEMORIA_VAULT_ROOT=/home/mark/vault/Claude
MEMORIA_MACHINE=PC-WILSON
MEMORIA_PROFILE=personal
MEMORIA_REPO_DIR=$HOME/Code/wilson-romero/claude-memory-system
MEMORIA_SYNC=rclone
# Own remote folder per machine: gdrive:Obsidian is taken by another machine's
# vault (mark-PC). Sharing it would merge two vaults that must stay separate.
MEMORIA_SYNC_REMOTE=gdrive:Obsidian-PC-WILSON
MEMORIA_LOG=$HOME/.local/log/memoria-cc.log

# Knowledge hub, SHARED with the other personal machine on purpose — and this
# is the opposite of the rule above only in appearance: the hub carries just
# Lecciones/, Memoria-CC/ and Decisiones/, it is joined by union
# (copy --ignore-existing, never bisync) and it holds nothing curated.
# It must stay a SIBLING of MEMORIA_SYNC_REMOTE, never a child: nested under
# the vault remote, bisync would pull the hub down into the vault.
MEMORIA_KNOWLEDGE_REMOTE=gdrive:Claude-Knowledge
