MEMORIA_VAULT_ROOT=/home/mark/vault/Claude
MEMORIA_MACHINE=PC-WILSON
MEMORIA_PROFILE=personal
MEMORIA_REPO_DIR=$HOME/Code/wilson-romero/claude-memory-system
MEMORIA_SYNC=rclone
# Own remote folder per machine: gdrive:Obsidian is taken by another machine's
# vault (mark-PC). Sharing it would merge two vaults that must stay separate.
MEMORIA_SYNC_REMOTE=gdrive:Obsidian-PC-WILSON
MEMORIA_LOG=$HOME/.local/log/memoria-cc.log
