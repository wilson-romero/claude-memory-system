MEMORIA_VAULT_ROOT=/home/mark/obsidian/ClaudeCode
MEMORIA_MACHINE=BOGWROMEROCA
MEMORIA_PROFILE=work
MEMORIA_REPO_DIR=$HOME/Code/wilson-romero/claude-memory-system
# OneDrive is handled outside this system (symlinked vault); install.sh has no
# branch for it on purpose, so no vault sync timer is deployed here.
MEMORIA_SYNC=onedrive
MEMORIA_LOG=$HOME/.local/log/memoria-cc.log

# No MEMORIA_KNOWLEDGE_REMOTE, deliberately: this is the WORK machine and it
# never joins the knowledge union. Knowledge reaches it only through
# /memory-promote, which scrubs client data and asks for approval.
# The absence is not the only safeguard — sync-knowledge.sh refuses to run
# under MEMORIA_PROFILE=work even if a remote is configured by mistake.
