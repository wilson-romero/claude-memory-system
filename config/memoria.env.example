# Per-machine config for the Claude memory system.
# install.sh copies this to ~/.claude/memoria.env on the first run; edit THAT
# file, not this one, and run install.sh again.
#
# NOTE: this file is loaded with `source`, so ALWAYS quote the values.
# An unquoted path containing spaces (e.g. /home/x/Documents/Obsidian Vault/Claude)
# makes bash split it and the install aborts with "No such file or directory".

# Folder INSIDE your Obsidian vault where the memory lives. The vault must
# exist; the folder is created if missing.
MEMORIA_VAULT_ROOT="/path/to/obsidian/vault/Claude"
MEMORIA_USER="Your Name"                  # how the prompts refer to you
MEMORIA_MACHINE="my-laptop"               # defaults to the hostname
MEMORIA_PROFILE="personal"                # personal | work
MEMORIA_SYNC="none"                       # rclone | onedrive | none
MEMORIA_SYNC_REMOTE="gdrive:Obsidian"     # rclone remote:path — only used when MEMORIA_SYNC=rclone
MEMORIA_LOG="$HOME/.local/log/memoria-cc.log"
# Curated files with a non-default name (vaults created before v2). Set by
# migrations/006 when it finds exactly one legacy candidate.
# MEMORIA_PREFS_FILE="preferencias.md"
# MEMORIA_PERFIL_FILE="perfil.md"
# MEMORIA_REPO_DIR defaults to wherever this repo is cloned; set it only to
# point the hooks at a different checkout.
# MEMORIA_SHARED_DIR="$HOME/.claude/shared-knowledge"   # see /memory-promote

# --- Async curator (Stop hook) — all optional, defaults shown ------------------
# MEMORIA_CURATOR_MODEL="claude-sonnet-5"   # model for the headless curator
# MEMORIA_CURATOR_TIMEOUT="600"             # seconds before the run is killed
# MEMORIA_DREAM_MODEL="claude-sonnet-5"     # model for the nightly dream
# MEMORIA_CURATOR_MIN_GAP="600"            # seconds between curations of ONE session
# MEMORIA_CURATOR_GLOBAL_GAP="1800"         # seconds between curations on this machine
#                                           # (the Stop hook fires every turn; these
#                                           # gaps are what keep the quota in check)
# MEMORIA_MISS_ALERT_AFTER="5"              # sessions without a VERIFIED write
#                                           # before SessionStart warns

# --- Knowledge union between PERSONAL machines --------------------------------
# One shared folder that every personal machine pushes to and pulls from. When
# set, sync-knowledge.sh keeps Lecciones/, Memoria-CC/ and Decisiones/ identical
# across them by union only (rclone copy --ignore-existing: it can add, never
# overwrite or delete).
# MEMORIA_KNOWLEDGE_REMOTE="gdrive:Claude-Knowledge"
#
# Two rules the script enforces, so do not work around them:
#   - it must be a SIBLING of MEMORIA_SYNC_REMOTE, never nested inside it, or
#     the vault bisync pulls the hub down into the vault (the script aborts);
#   - on MEMORIA_PROFILE="work" the script refuses to run even if this is set.
#     Leave it UNSET there anyway — that machine uses /memory-promote, which
#     scrubs client data and asks for approval.
#
# MEMORIA_KNOWLEDGE_FAIL_LIMIT="3"          # consecutive unreachable runs
#                                           # tolerated (~1.5 h) before the
#                                           # service goes red. Being offline is
#                                           # normal; being offline forever is a
#                                           # dead token, and the counter is what
#                                           # tells the two apart.
#
# Replaced MEMORIA_PEER/_PORT/_VAULT (rsync over SSH) in v1.5.0. Those needed
# both machines awake at once; migrations/005 renames them out of the way.
